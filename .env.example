# Local development only. `pnpm dev:local` copies this to .env on first run (.env is gitignored).
# Never put real credentials here or in .env.

# Database (MariaDB in Docker, see compose.yaml). The same variables the app reads.
NUXT_DATABASE_HOST=127.0.0.1
NUXT_DATABASE_PORT=3307
NUXT_DATABASE_USER=ksh
NUXT_DATABASE_PASSWORD=ksh_local_password
NUXT_DATABASE_NAME=ksh

# Password for the /review page, at least 16 characters. Local value only.
NUXT_REVIEW_SECRET=local-review-password

# Docker-only extras (not read by the app).
DB_ROOT_PASSWORD=ksh_local_root
ADMINER_PORT=8081
