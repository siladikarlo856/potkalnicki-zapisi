# Local development only. `pnpm dev:local` copies this to .env on first run (.env is gitignored),
# starts the local Supabase stack and fills in the three NUXT_SUPABASE_* values below from it.
# Never put real credentials here or in .env.

# Supabase. Locally these come from `supabase start` (pnpm db:up); in production from Hostinger.
# Both naming styles work: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_KEY are read when the
# NUXT_ ones are empty.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
# Server only: lets /review list, approve, reject and delete. Never expose it to the browser.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Password for the /review page, at least 16 characters. Local value only.
NUXT_REVIEW_SECRET=local-review-password
