# Local development only. `pnpm dev:local` copies this to .env on first run (.env is gitignored),
# starts the local Supabase stack and fills in the URL and secret key below.
# Never put real credentials here or in .env.

NUXT_SUPABASE_URL=
# One server-only secret key for submissions and review. Never expose it to the browser.
NUXT_SUPABASE_SERVICE_ROLE_KEY=
# Hostinger injects SUPABASE_URL and SUPABASE_API_KEY instead; no duplicate key is needed.
# The NUXT_ values above are optional overrides and take precedence when nonempty.

# Password checked by the /admin login, at least 16 characters. Local value only.
NUXT_REVIEW_SECRET=local-review-password
# Seals the httpOnly admin session cookie, at least 32 characters. Use a separate random value.
NUXT_ADMIN_SESSION_PASSWORD=local-admin-session-password-32-chars

# Optional override for the public Cloudflare Web Analytics token.
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=56bd22857e3547448cffa5b62e2ffa7e

# Challenge requests per IP per window. Defaults: 5 creates, 20 joins, 240 actions.
NUXT_CHALLENGE_RATE_LIMIT_CREATE=5
NUXT_CHALLENGE_RATE_LIMIT_JOIN=20
NUXT_CHALLENGE_RATE_LIMIT_ACTION=240
NUXT_CHALLENGE_RATE_LIMIT_WINDOW_SECONDS=600
