{
  "name": "nuxt-ui-template-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "env:init": "[ -f .env ] || cp .env.example .env",
    "db:up": "pnpm env:init && docker compose up -d --wait db",
    "db:down": "docker compose --profile tools down",
    "db:reset": "pnpm env:init && docker compose --profile tools down -v && docker compose up -d --wait db",
    "db:logs": "docker compose logs -f db",
    "db:shell": "docker compose exec db sh -c 'mariadb -u\"$MARIADB_USER\" -p\"$MARIADB_PASSWORD\" \"$MARIADB_DATABASE\"'",
    "db:browser": "pnpm db:up && docker compose --profile tools up -d --wait adminer",
    "dev:local": "pnpm db:up && nuxt dev"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/simple-icons": "1.2.100",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3"
  },
  "pnpm": {
    "overrides": {
      "@iconify-json/simple-icons": "1.2.100",
      "@iconify/collections": "1.0.755",
      "rollup": "4.65.0",
      "@rollup/rollup-android-arm-eabi": "4.65.0",
      "@rollup/rollup-android-arm64": "4.65.0",
      "@rollup/rollup-darwin-arm64": "4.65.0",
      "@rollup/rollup-darwin-x64": "4.65.0",
      "@rollup/rollup-freebsd-arm64": "4.65.0",
      "@rollup/rollup-freebsd-x64": "4.65.0",
      "@rollup/rollup-linux-arm-gnueabihf": "4.65.0",
      "@rollup/rollup-linux-arm-musleabihf": "4.65.0",
      "@rollup/rollup-linux-arm64-gnu": "4.65.0",
      "@rollup/rollup-linux-arm64-musl": "4.65.0",
      "@rollup/rollup-linux-loong64-gnu": "4.65.0",
      "@rollup/rollup-linux-loong64-musl": "4.65.0",
      "@rollup/rollup-linux-ppc64-gnu": "4.65.0",
      "@rollup/rollup-linux-ppc64-musl": "4.65.0",
      "@rollup/rollup-linux-riscv64-gnu": "4.65.0",
      "@rollup/rollup-linux-riscv64-musl": "4.65.0",
      "@rollup/rollup-linux-s390x-gnu": "4.65.0",
      "@rollup/rollup-linux-x64-gnu": "4.65.0",
      "@rollup/rollup-linux-x64-musl": "4.65.0",
      "@rollup/rollup-win32-arm64-msvc": "4.65.0",
      "@rollup/rollup-win32-ia32-msvc": "4.65.0",
      "@rollup/rollup-win32-x64-msvc": "4.65.0"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0"
}
